# LLM
# LLM_PROVIDER must be exactly one of: openai | gemini | ollama
# Do NOT put comments on the same line as a value.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Search (optional - DuckDuckGo needs no key)
SEARCH_API_KEY=
SERPER_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev@postgres:5432/nexus

# Redis
REDIS_URL=redis://redis:6379

# ChromaDB
CHROMA_URL=http://chroma:8000

# Auth
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_MIN=60

# Per-agent model overrides (leave blank to use provider defaults)
# When using Ollama, set these to different local models:
RESEARCH_MODEL=
CODING_MODEL=
EMAIL_MODEL=
ROUTING_MODEL=

# App
APP_NAME=SAKSHAM
DEBUG=true
CORS_ORIGINS=http://localhost:3000
